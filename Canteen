import java.util.Scanner;

public class Canteen {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        String[] food = {
            "Burger",
            "Fries",
            "Chicken",
            "Spaghetti",
            "Soda"
        };

        double[] price = {
            50.00,
            35.00,
            80.00,
            60.00,
            25.00
        };

        int totalQuantity = 0;
        double totalAmount = 0;
        boolean isStudent = false;

        char orderAgain = 'Y';

        System.out.println("===== CANTEEN MENU =====");

        for (int i = 0; i < food.length; i++) {
            System.out.println((i + 1) + ". " + food[i]
                    + " - $" + price[i]);
        }

        while (orderAgain == 'Y' || orderAgain == 'y') {

            System.out.print("\nEnter item number: ");
            int itemNumber = input.nextInt();

            System.out.print("Enter quantity: ");
            int quantity = input.nextInt();

            System.out.print("Are you a student? (Y/N): ");
            char student = input.next().charAt(0);

            if (itemNumber < 1 || itemNumber > 5) {
                System.out.println("Invalid item number.");
                continue;
            }

            if (quantity < 1 || quantity > 10) {
                System.out.println("Invalid quantity. Quantity must be from 1 to 10.");
                continue;
            }

            if (student != 'Y' && student != 'y'
                    && student != 'N' && student != 'n') {
                System.out.println("Invalid student status.");
                continue;
            }

            if (student == 'Y' || student == 'y') {
                isStudent = true;
            }

            double orderAmount = price[itemNumber - 1] * quantity;

            totalAmount += orderAmount;
            totalQuantity += quantity;

            System.out.println("\nOrder accepted.");
            System.out.println("Item: " + food[itemNumber - 1]);
            System.out.println("Quantity: " + quantity);
            System.out.println("Order amount: $" + orderAmount);

            System.out.print("\nDo you want to order again? (Y/N): ");
            orderAgain = input.next().charAt(0);
        }

        double totalDeduction;

        if (isStudent && totalAmount >= 500) {
            totalDeduction = totalAmount * 0.15;
        } else if (isStudent) {
            totalDeduction = totalAmount * 0.10;
        } else if (totalAmount >= 500) {
            totalDeduction = totalAmount * 0.05;
        } else {
            totalDeduction = 0;
        }

        double finalAmount = totalAmount - totalDeduction;

        System.out.println("\n===== FINAL SUMMARY =====");
        System.out.println("Total quantity of items: " + totalQuantity);
        System.out.println("Total amount before deductions: $" + totalAmount);
        System.out.println("Total deduction: $" + totalDeduction);
        System.out.println("Final amount to pay: $" + finalAmount);

        input.close();
    }
}

